// test/gfx/gfx_compute_cycle.goose in Clarus: a compute pass that cycles what it writes. Two frames each rewrite all
// of a storage texture and a storage buffer, frame 2 while frame 1's sampling of the texture and its read of the
// buffer may still be in flight. Each frame's draw and read back must see that frame's values. It prints
// test/gfx/gfx_compute_cycle.out.

import gfx
import shaders

fn u32_at(b: Slice<u8>, i: i64) -> u32 {
	return u32(b[4 * i]) | (u32(b[4 * i + 1]) << 8) | (u32(b[4 * i + 2]) << 16) | (u32(b[4 * i + 3]) << 24)
}

fn main() -> i32 {
	if !gfx.open_headless(4, 1) {
		use why = gfx.error()
		if let t = Text.from_utf8(why.all()) { eprint("gfx: {}\n", t) }
		return 1
	}
	let field = gfx.texture2d(4, 1, gfx.RGBA8, gfx.COMPUTE_WRITE | gfx.SAMPLED)
	use none = List<u8>.new()
	let counts = gfx.buffer(gfx.BUFFER_COMPUTE_WRITE, 16, none.all())
	let write = gfx.compute_pipeline(shaders.cycle_comp())
	let desc = gfx.pipeline_desc()
	let sample = gfx.pipeline(shaders.sample_vert(), shaders.sample_frag(), desc)
	let nearest = gfx.sampler(gfx.NEAREST, gfx.CLAMP)
	let targets = [gfx.render_target(4, 1, gfx.RGBA8), gfx.render_target(4, 1, gfx.RGBA8)]
	var reads = [gfx.Readback { id: 0 }; 2]
	let bufs = [counts]
	let texs = [field]
	for f in 0..2 {
		gfx.begin_compute(bufs.all(), texs.all(), true)
		gfx.bind_compute(write)
		let value: [u32; 4] = [u32(10 * (f + 1)), 0, 0, 0]
		gfx.uniforms(gfx.COMPUTE, 0, value)
		gfx.dispatch(1, 1, 1)
		gfx.end_compute()
		gfx.begin_pass_into(targets[f], gfx.Texture { id: 0 }, gfx.Float4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 })
		gfx.bind_pipeline(sample)
		gfx.bind_texture(gfx.FRAGMENT, 0, field, nearest)
		gfx.draw(3)
		gfx.end_pass()
		reads[f] = gfx.read_buffer_async(counts, 0, 16)
		gfx.frame()
	}
	for f in 0..2 {
		use px = gfx.read_pixels(targets[f])
		use got = gfx.take_readback(reads[f])
		print("frame {}: sampled ", f + 1)
		for x in 0..4 {
			if x > 0 { print("  ") }
			print("{},{},{},{}", px[x * 4], px[x * 4 + 1], px[x * 4 + 2], px[x * 4 + 3])
		}
		print("; buffer [{}, {}, {}, {}]\n", u32_at(got.all(), 0), u32_at(got.all(), 1), u32_at(got.all(), 2), u32_at(got.all(), 3))
	}
	gfx.close()
	return 0
}
