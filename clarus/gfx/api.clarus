// TextureDesc with the field defaults gfx.goose gives it.
fn texture_desc() -> TextureDesc {
	var d = TextureDesc { .. }
	d.format = 1
	d.usage = 1
	d.depth = 1
	d.mips = 1
	d.samples = 1
	return d
}

// SamplerDesc with the field defaults gfx.goose gives it.
fn sampler_desc() -> SamplerDesc {
	var d = SamplerDesc { .. }
	d.min_filter = 1
	d.mag_filter = 1
	d.mip_filter = 1
	d.max_anisotropy = 1.0
	d.max_lod = 1000.0
	return d
}

// PipelineDesc with the field defaults gfx.goose gives it.
fn pipeline_desc() -> PipelineDesc {
	var d = PipelineDesc { .. }
	d.depth_compare = 2
	d.instance_location = -1
	d.blend_src = 2
	d.blend_dst = 1
	d.blend_op = 1
	d.blend_src_alpha = 2
	d.blend_dst_alpha = 1
	d.blend_op_alpha = 1
	d.write_mask = 15
	d.stencil_compare = 8
	d.stencil_fail = 1
	d.stencil_depth_fail = 1
	d.stencil_pass = 1
	d.stencil_back_fail = 1
	d.stencil_back_depth_fail = 1
	d.stencil_back_pass = 1
	d.stencil_read_mask = 255
	d.stencil_write_mask = 255
	return d
}

// PassDesc with the field defaults gfx.goose gives it.
fn pass_desc() -> PassDesc {
	var d = PassDesc { .. }
	d.clear_color = 1
	d.clear_depth = 1
	d.color_value = Float4 { x: 0.0, y: 0.0, z: 0.0, w: 1.0 }
	d.depth_value = 1.0
	d.clear_stencil = 1
	for i in 0..4 { d.color_values[i] = Float4 { x: 0.0, y: 0.0, z: 0.0, w: 1.0 } }
	return d
}
