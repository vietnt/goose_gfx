// The module ui for Clarus: Nuklear immediate-mode ui through this package's C layer (src/ui/), the same layer
// ui.goose declares, drawn through gfx. api.clarus beside this file is generated from src/ui/ui_api.h
// (clarus/gen.py) and holds the structs, constants and the private externs; this file holds the functions a program
// calls, after ui.goose's, and the renderer. Its types that gfx also has are prefixed Ui (UiFloat2), because one C
// file holds both modules' types.
//
// It has the functions of ui.goose that rome_goose calls. Clarus has no overloading (M8): `destroy` is the context's
// and destroy_font_atlas the atlas's, and a call gives every argument that ui.goose defaults. Drawn text goes as
// bytes, as rome_goose slices it; a window's title as Text.
//
// render() needs a Renderer, which the program makes once with renderer() and keeps: what ui.goose keeps in a
// global, a Clarus module has only as a root that every caller would bind. Make one per program, as ui.goose has one:
// a second would make its own pipeline and buffers, and the atlas textures one releases are those the other made.

import gfx

// --- errors ------------------------------------------------------------------

// Why the last call that failed did.
fn error() -> List<u8> {
	var text = List<u8>.filled(1024, 0)
	let n = gsc_ui_error(text.all_mut())
	text.resize(if n < 1024 { n } else { 1024 })
	return text
}

// Aborts, saying why, if the program has used ui wrongly.
fn check() {
	if gsc_ui_misuse_count() > 0 {
		use why = error()
		if let t = Text.from_utf8(why.all()) { eprint("ui: {}\n", t) } else { eprint("ui: misuse ({} bytes of error text, not UTF-8)\n", why.len()) }
		assert(false)
	}
}

// --- font atlases and fonts --------------------------------------------------

// Fonts are baked into an atlas, one image holding the glyphs of all its fonts: made, fonts added, baked, and then
// usable by any context. render() uploads a baked atlas's image to the GPU when it first draws with it.
fn create_font_atlas() -> FontAtlas { return gsc_ui_create_font_atlas() }
// Destroys the atlas and its fonts; not while a context uses them.
fn destroy_font_atlas(a: FontAtlas) {
	check()
	gsc_ui_destroy_font_atlas(a)
}

// A TrueType or OpenType font from its bytes, with the characters of `ranges` (pairs of first and last; empty: the
// config's RANGE_* set).
fn add_font_from_memory(a: FontAtlas, ttf: Slice<u8>, height: f32, config: FontConfig, ranges: Slice<u32>) -> Font {
	return gsc_ui_add_font_from_memory(a, ttf, height, config, ranges)
}

// Nuklear's built-in font, a bitmap one at its best at 13 and whole multiples.
fn add_default_font(a: FontAtlas, height: f32, config: FontConfig) -> Font {
	use none = List<u32>.new()
	return gsc_ui_add_default_font(a, height, config, none.all())
}

// Rasterizes the fonts added into the atlas's image, the glyphs `scale` times the fonts' size (sharp text for a ui
// drawn with set_scale at the same scale).
fn bake(a: FontAtlas, scale: f32) -> bool { return gsc_ui_bake_font_atlas(a, scale) != 0 }

// Metrics at the size the font was baked, once it is.
fn info(f: Font) -> FontInfo { return gsc_ui_font_info_of(f) }
// How wide `text` is drawn in this font, in pixels.
fn text_width(f: Font, text: Slice<u8>) -> f32 { return gsc_ui_font_text_width(f, text) }

// --- contexts ----------------------------------------------------------------

// A context drawing with `font`, from a baked atlas; its windows and their state live in it.
fn create_context(font: Font) -> Context { return gsc_ui_create_context(font) }
fn destroy(c: Context) {
	check()
	gsc_ui_destroy_context(c)
}
// Ends a frame: drops what it drew, and the windows not begun in it.
fn clear(c: Context) { gsc_ui_clear(c) }
// The whole ui `scale` times bigger, laid out as before. Not during a frame; 1 at first.
fn set_scale(c: Context, scale: f32) -> bool { return gsc_ui_set_scale(c, scale) != 0 }

// --- windows -----------------------------------------------------------------

// A window, named by its title: true when it is open to fill. end() follows either way.
fn begin(c: Context, title: Text, bounds: Rect, flags: i64) -> bool { return gsc_ui_begin(c, title.bytes(), bounds, flags) != 0 }
fn end(c: Context) { gsc_ui_end(c) }

// --- style -------------------------------------------------------------------

// The whole style, changed as a value and set back.
fn style(c: Context) -> Style { return gsc_ui_style_of(c) }
fn set_style(c: Context, s: &Style) { gsc_ui_set_style(c, s) }
// Nothing drawn: a transparent color.
fn style_item_hide() -> StyleItem {
	var item = StyleItem { .. }
	item.kind = STYLE_ITEM_COLOR
	return item
}

// --- drawing in the window being built ---------------------------------------

fn stroke_rect(c: Context, r: Rect, rounding: f32, line_thickness: f32, color: Color) { gsc_ui_stroke_rect(c, r, rounding, line_thickness, color) }
fn stroke_circle(c: Context, r: Rect, line_thickness: f32, color: Color) { gsc_ui_stroke_circle(c, r, line_thickness, color) }
fn fill_rect(c: Context, r: Rect, rounding: f32, color: Color) { gsc_ui_fill_rect(c, r, rounding, color) }
fn fill_circle(c: Context, r: Rect, color: Color) { gsc_ui_fill_circle(c, r, color) }
fn fill_polygon(c: Context, points: Slice<UiFloat2>, color: Color) { gsc_ui_fill_polygon(c, points, color) }
fn draw_image(c: Context, r: Rect, img: Image, color: Color) { gsc_ui_draw_image(c, r, img, color) }
fn draw_text(c: Context, r: Rect, text: Slice<u8>, font: Font, background: Color, foreground: Color) {
	gsc_ui_draw_text(c, r, text, font, background, foreground)
}
fn push_scissor(c: Context, r: Rect) { gsc_ui_push_scissor(c, r) }

// Part of a texture w x h, `region` in pixels; `texture` is a gfx.Texture's id.
fn subimage_id(texture: u32, w: u16, h: u16, region: Rect) -> Image {
	var img = Image { .. }
	img.texture = texture
	img.w = w
	img.h = h
	img.region[0] = u16(region.x)
	img.region[1] = u16(region.y)
	img.region[2] = u16(region.w)
	img.region[3] = u16(region.h)
	return img
}

// --- through gfx -------------------------------------------------------------

// What drawing through gfx keeps between frames, shared by every context: made by renderer() after gfx is open, and
// made again by render() after gfx is opened again (its handles died with gfx.close).
struct Renderer {
	opened: i64,                    // gfx.open_count() when made
	pipeline: gfx.Pipeline,
	sampler: gfx.Sampler,
	vertex_buffer: gfx.Buffer,
	vertex_capacity: i64,           // bytes
	index_buffer: gfx.Buffer,
	index_capacity: i64,
	// The textures upload_atlases made, released with their atlases; a 0 is a free slot.
	textures: List<u32>,
}

fn renderer() -> Renderer {
	var r = Renderer { opened: 0, pipeline: gfx.Pipeline { id: 0 }, sampler: gfx.Sampler { id: 0 },
		vertex_buffer: gfx.Buffer { id: 0 }, vertex_capacity: 0, index_buffer: gfx.Buffer { id: 0 }, index_capacity: 0,
		textures: List<u32>.new() }
	make_renderer(mut r)
	return r
}

private fn make_renderer(mut r: Renderer) {
	var desc = gfx.pipeline_desc()
	desc.blend = gfx.BLEND_ALPHA
	desc.formats[2] = gfx.VERTEX_UBYTE4_NORM
	r.pipeline = gfx.pipeline(ui_vert(), ui_frag(), desc)
	r.sampler = gfx.sampler(gfx.LINEAR, gfx.CLAMP)
	r.vertex_buffer = gfx.Buffer { id: 0 }
	r.vertex_capacity = 0
	r.index_buffer = gfx.Buffer { id: 0 }
	r.index_capacity = 0
	// After gfx is opened again, the atlases' textures died with the gfx they were made in. A first make leaves them
	// alone: another Renderer's textures would leak.
	if r.opened != 0 {
		gsc_ui_forget_font_atlas_textures()
		for i in 0..r.textures.len() { r.textures[i] = 0 }
	}
	r.opened = gfx.open_count()
}

// A buffer of at least `bytes`, grown to the next power of two.
private fn ensure_buffer(mut b: gfx.Buffer, mut capacity: i64, usage: i32, bytes: i64) {
	if bytes <= capacity { return }
	if b.id != 0 { gfx.release_buffer(b) }
	var size: i64 = 4096
	while size < bytes { size = size * 2 }
	capacity = size
	use none = List<u8>.new()
	b = gfx.buffer(usage, size, none.all())
}

private fn position(xs: Slice<u32>, x: u32) -> i64 {
	for i in 0..xs.len() {
		if xs[i] == x { return i }
	}
	return -1
}

// Uploads the image of every baked atlas no texture holds yet, and releases the textures of those destroyed.
private fn upload_atlases(mut r: Renderer) {
	use none = List<u32>.new()
	let n = gsc_ui_released_textures(none.all_mut())
	use released = List<u32>.filled(n, 0)
	gsc_ui_released_textures(released.all_mut())
	for t in released.all() {
		let i = position(r.textures.all(), t)
		if i >= 0 {
			gfx.release_texture(gfx.Texture { id: t })
			r.textures[i] = 0
		}
	}
	while true {
		let a = gsc_ui_font_atlas_without_texture()
		if a.id == 0 { break }
		var size = UiInt2 { x: 0, y: 0 }
		gsc_ui_font_atlas_size(a, mut size)
		use px = List<u8>.filled(i64(size.x) * i64(size.y) * 4, 0)
		gsc_ui_font_atlas_pixels(a, px.all_mut())
		let t = gfx.texture2d(i64(size.x), i64(size.y), gfx.RGBA8, gfx.SAMPLED)
		let all = gfx.Region { .. }
		gfx.update_texture(t, all, px.all())
		gsc_ui_set_font_atlas_texture(a, t.id)
		let free = position(r.textures.all(), 0)
		if free >= 0 { r.textures[free] = t.id } else { r.textures.push(t.id) }
	}
}

// Draws the context's frame over `target`, a gfx texture of COLOR_TARGET usage, with alpha blending; not inside a
// pass. The frame's windows must have ended.
fn render_into(mut r: Renderer, c: Context, target: gfx.Texture) {
	check()
	if r.opened != gfx.open_count() { make_renderer(mut r) }
	upload_atlases(mut r)
	let config = convert_config()
	gsc_ui_convert(c, config)
	check()
	use no_draws = List<DrawCommand>.new()
	let nd = gsc_ui_draw_commands(c, no_draws.all_mut())
	if nd == 0 { return }
	use draws = List<DrawCommand>.filled(nd, DrawCommand { .. })
	gsc_ui_draw_commands(c, draws.all_mut())
	use no_verts = List<Vertex>.new()
	let nv = gsc_ui_vertices(c, no_verts.all_mut())
	use verts = List<Vertex>.filled(nv, Vertex { .. })
	gsc_ui_vertices(c, verts.all_mut())
	use no_idx = List<u32>.new()
	let ni = gsc_ui_indices(c, no_idx.all_mut())
	use idx = List<u32>.filled(ni, 0)
	gsc_ui_indices(c, idx.all_mut())
	// Plain data as the bytes gfx uploads: Clarus has no generic bytes_of yet, so the cast is written here.
	let vbytes = nv * i64(size_of(Vertex))
	let ibytes = ni * 4
	let vdata: Slice<u8> = Unsafe.slice(Unsafe.cast(Unsafe.addr(verts[0])), vbytes)
	let idata: Slice<u8> = Unsafe.slice(Unsafe.cast(Unsafe.addr(idx[0])), ibytes)
	ensure_buffer(mut r.vertex_buffer, mut r.vertex_capacity, gfx.BUFFER_VERTEX, vbytes)
	ensure_buffer(mut r.index_buffer, mut r.index_capacity, gfx.BUFFER_INDEX, ibytes)
	gfx.update_buffer(r.vertex_buffer, 0, vdata)
	gfx.update_buffer(r.index_buffer, 0, idata)
	let info = gfx.texture_info(target)
	var pass = gfx.pass_desc()
	pass.clear_color = 0
	pass.clear_depth = 0
	pass.color[0] = target
	gfx.begin_pass(pass)
	gfx.bind_pipeline(r.pipeline)
	gfx.bind_vertex_buffer(0, r.vertex_buffer, 0)
	gfx.bind_index_buffer(r.index_buffer, 4, 0)
	let size: [f32; 4] = [f32(info.width), f32(info.height), 0.0, 0.0]
	gfx.uniforms(gfx.VERTEX, 0, Unsafe.slice(Unsafe.cast(Unsafe.addr(size[0])), 16))
	var first: i64 = 0
	for d in draws.all() {
		// Scissors in whole pixels, inside the target.
		let x0 = clamp(floor_i(d.clip_rect.x), 0, i64(info.width))
		let y0 = clamp(floor_i(d.clip_rect.y), 0, i64(info.height))
		let x1 = clamp(ceil_i(d.clip_rect.x + d.clip_rect.w), 0, i64(info.width))
		let y1 = clamp(ceil_i(d.clip_rect.y + d.clip_rect.h), 0, i64(info.height))
		if x1 > x0 && y1 > y0 {
			gfx.scissor(x0, y0, x1 - x0, y1 - y0)
			gfx.bind_texture(gfx.FRAGMENT, 0, gfx.Texture { id: d.texture }, r.sampler)
			gfx.draw_indexed(i64(d.elem_count), 1, first, 0)
		}
		first = first + i64(d.elem_count)
	}
	gfx.end_pass()
}

// Over the screen.
fn render(mut r: Renderer, c: Context) { render_into(mut r, c, gfx.screen()) }

private fn clamp(x: i64, lo: i64, hi: i64) -> i64 { return if x < lo { lo } else if x > hi { hi } else { x } }
// A clip rectangle's edges are far inside the i64 range: Nuklear clips them to the target or to a huge rectangle.
private fn floor_i(x: f32) -> i64 {
	let c = if x < -1.0e9 { -1.0e9 } else if x > 1.0e9 { 1.0e9 } else { x }
	let i = i64(c)
	return if f32(i) > c { i - 1 } else { i }
}
private fn ceil_i(x: f32) -> i64 {
	let c = if x < -1.0e9 { -1.0e9 } else if x > 1.0e9 { 1.0e9 } else { x }
	let i = i64(c)
	return if f32(i) < c { i + 1 } else { i }
}
