// FontConfig with the field defaults ui.goose gives it.
fn font_config() -> FontConfig {
	var d = FontConfig { .. }
	d.oversample_h = 1
	d.oversample_v = 1
	d.fallback_glyph = 63
	return d
}

// ConvertConfig with the field defaults ui.goose gives it.
fn convert_config() -> ConvertConfig {
	var d = ConvertConfig { .. }
	d.global_alpha = 1.0
	d.line_aa = 1
	d.shape_aa = 1
	d.circle_segment_count = 22
	d.arc_segment_count = 22
	d.curve_segment_count = 22
	return d
}
